# ===================================================================
# BẾP QUÊ - SECURE ENVIRONMENT CONFIGURATION
# CẢNH BÁO BẢO MẬT QUAN TRỌNG:
# 1. KHÔNG BAO GIỜ thêm tiền tố NEXT_PUBLIC_ vào Database URL, Secret Key, API Key hay Token.
# 2. Tiền tố NEXT_PUBLIC_* chỉ dùng DUY NHẤT cho URL công khai của trang web, Sitekey Turnstile hoặc các biến không nhạy cảm.
# 3. File .env.local và các secret thực tế phải được thêm vào .gitignore, không được commit lên GitHub.
# ===================================================================

# -------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SERVER-ONLY - Tuyệt đối không dùng NEXT_PUBLIC_)
# -------------------------------------------------------------------
# Supabase PostgreSQL / Cloud Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# -------------------------------------------------------------------
# 2. PAYMENT GATEWAY & WEBHOOK SECRETS (SERVER-ONLY)
# -------------------------------------------------------------------
# Khóa bí mật ký số HMAC-SHA256 cho Webhook thanh toán (VietQR, MoMo, VNPay...)
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret-key-at-least-32-chars

# Khóa bí mật API nội bộ dành cho nhân viên quản trị (Admin / Staff)
ADMIN_API_KEY=your-internal-admin-secret-api-key

# -------------------------------------------------------------------
# 3. THIRD-PARTY SERVICES & INTEGRATIONS (SERVER-ONLY)
# -------------------------------------------------------------------
# Webhook Google Sheets tự động ghi nhận đơn hàng
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx.../exec

# -------------------------------------------------------------------
# 4. BOT PROTECTION (CLOUDFLARE TURNSTILE)
# -------------------------------------------------------------------
# Public Sitekey hiển thị widget trên trình duyệt (Mặc định là Always-Pass Test Key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-only Secret Key để xác thực token với Cloudflare (Mặc định là Always-Pass Test Secret)
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -------------------------------------------------------------------
# 5. RATE LIMITING (UPSTASH REDIS - TÙY CHỌN)
# Mặc định hệ thống dùng In-Memory Sliding Window Counter hiệu năng cao nếu không cấu hình Redis.
# -------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# -------------------------------------------------------------------
# 6. PUBLIC APPLICATION URL (CHỈ DÀNH CHO URL CÔNG KHAI CỦA ỨNG DỤNG)
# -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://bepque.vn
